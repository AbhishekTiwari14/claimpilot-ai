# All defaults also work when .env is absent.
CLAIMPILOT_LLM_PROVIDER=offline
GROQ_MODEL=openai/gpt-oss-20b
GROQ_VISION_MODEL=qwen/qwen3.8-27b
GROQ_API_KEY=
CLAIMPILOT_LLM_TIMEOUT_SECONDS=12
CLAIMPILOT_LLM_MAX_RETRIES=1
CLAIMPILOT_INTAKE_DB=data/runtime/intake.sqlite3
# Local synthetic claimant credentials. Configure private values in .env.
CLAIMPILOT_CLAIMANTS=[]
CLAIMPILOT_PHOTO_MAX_BYTES=8388608
CLAIMPILOT_PHOTO_MAX_DIMENSION=6000
CLAIMPILOT_PHOTO_MAX_PIXELS=16000000
CLAIMPILOT_PHOTO_OUTPUT_EDGE=1024
CLAIMPILOT_PHOTOS_PER_CLAIM=30
CLAIMPILOT_KB_OPERATORS=[]
CLAIMPILOT_KB_CHROMA=data/runtime/chroma
CLAIMPILOT_KB_MODEL_CACHE=data/runtime/embeddings
CLAIMPILOT_KB_MAX_BYTES=5242880
CLAIMPILOT_KB_CHUNK_SIZE=800
CLAIMPILOT_KB_CHUNK_OVERLAP=150
CLAIMPILOT_KB_BATCH_SIZE=24
CLAIMPILOT_KB_TOP_K=5
CLAIMPILOT_AGENT_MAX_ITERATIONS=10
CLAIMPILOT_AGENT_MAX_TOOL_CALLS=12
CLAIMPILOT_AGENT_TOOL_TIMEOUT_SECONDS=5
CLAIMPILOT_AGENT_DEADLINE_SECONDS=100
