# All defaults also work when .env is absent.
CLAIMPILOT_LLM_PROVIDER=offline
GROQ_MODEL=openai/gpt-oss-20b
GROQ_VISION_MODEL=qwen/qwen3.8-27b
GROQ_API_KEY=added_in_.env
CLAIMPILOT_LLM_TIMEOUT_SECONDS=12
CLAIMPILOT_LLM_MAX_RETRIES=1
CLAIMPILOT_INTAKE_DB=data/runtime/intake.sqlite3
# Local synthetic claimant credentials. Configure private values in .env.
CLAIMPILOT_CLAIMANTS=[]
 