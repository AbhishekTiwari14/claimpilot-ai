# Copy to .env.docker and supply your HTTPS origin and Groq key.
CLAIMPILOT_HOSTED_DEMO=true
CLAIMPILOT_DEMO_ORIGIN=https://claims.example.com
CLAIMPILOT_LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_VISION_MODEL=qwen/qwen3.8-27b
CLAIMPILOT_LLM_TIMEOUT_SECONDS=12
CLAIMPILOT_LLM_MAX_RETRIES=1

# Set to the IP or CIDR of the HTTPS proxy as seen from the container.
# The proxy must overwrite forwarded scheme and client IP headers.
FORWARDED_ALLOW_IPS=127.0.0.1

CLAIMPILOT_DEMO_TTL_SECONDS=3600
CLAIMPILOT_DEMO_ACTIVE_WORKSPACES=12
CLAIMPILOT_DEMO_WORKSPACES_PER_HOUR=12
CLAIMPILOT_DEMO_WORKSPACES_PER_IP_HOUR=3
CLAIMPILOT_DEMO_REQUESTS_PER_MINUTE=120
CLAIMPILOT_DEMO_MUTATIONS_PER_WORKSPACE=100
CLAIMPILOT_DEMO_UPLOADS_PER_WORKSPACE=16
CLAIMPILOT_DEMO_MODEL_CALLS_PER_WORKSPACE=45
CLAIMPILOT_DEMO_MODEL_CALLS_PER_HOUR=300
CLAIMPILOT_KB_MAX_BYTES=5242880
CLAIMPILOT_PHOTO_MAX_BYTES=8388608
